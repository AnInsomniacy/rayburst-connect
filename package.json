{
  "name": "rayburst-connect",
  "description": "Rayburst Connect — Send downloads to Rayburst",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=24.16.0 <27",
    "pnpm": ">=10.34.1 <11"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "media:contract": "tsx scripts/export-media-contract.ts",
    "media:contract:check": "tsx scripts/export-media-contract.ts --check",
    "build": "wxt build -b chromium",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip -b chromium",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:all": "wxt zip -b chromium && wxt zip -b firefox --mv3",
    "compile": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:i18n": "tsx scripts/lint-i18n.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@vicons/ionicons5": "^0.13.0",
    "content-disposition": "^1.1.0",
    "ky": "^2.0.2",
    "lettercoder": "^0.1.1",
    "mpegts.js": "1.8.2",
    "naive-ui": "^2.44.1",
    "picomatch": "^4.0.4",
    "sanitize-filename": "^1.6.4",
    "shaka-player": "4.16.49",
    "vue": "^3.5.29",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/content-disposition": "^0.5.9",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "4.1.2",
    "@wxt-dev/auto-icons": "1.1.2",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "happy-dom": "^20.8.9",
    "prettier": "^3.8.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "unplugin-vue-components": "^32.0.0",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.2.5",
    "web-ext": "^10.4.0",
    "wxt": "^0.20.20"
  }
}
